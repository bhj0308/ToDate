# Hosted demo backend (Render) — reachable from a real device on any network.
EXPO_PUBLIC_API_URL=https://todate-demo.onrender.com

# Local dev alternative. iOS simulator can use localhost; Android emulator needs
# 10.0.2.2 instead. Note the WebSocket URL is derived from this value
# (http->ws, https->wss), so it must include the scheme.
# EXPO_PUBLIC_API_URL=http://localhost:8000
